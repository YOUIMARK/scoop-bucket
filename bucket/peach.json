{
    "version": "0.50.0",
    "description": "Single-user, local-first personal media system with metadata scraping, library management and browser access",
    "homepage": "https://peach.video",
    "license": "AGPL-3.0-only",
    "notes": [
        "Data (config, database, cache) lives in the persist folder and is linked to %LOCALAPPDATA%\\Peach, so upgrading or reinstalling this package keeps it.",
        "'scoop uninstall peach' keeps the data; add -p to remove it together with the link.",
        "Upgrade with 'scoop update peach'. The built-in updater rewrites files managed by Scoop, so turn off automatic update downloads in Settings > App and Maintenance."
    ],
    "architecture": {
        "64bit": {
            "url": "https://downloads.peach.video/v0.50.0/Peach-0.50.0-windows-x64.zip",
            "hash": "ad1629c04254acdd45957c5fda66e332c497056595b9dc3ced408be512c0a030"
        }
    },
    "extract_dir": "Peach",
    "shortcuts": [
        [
            "Peach.exe",
            "Peach"
        ]
    ],
    "installer": {
        "script": [
            "$link = Join-Path $env:LOCALAPPDATA 'Peach'",
            "$target = Join-Path $persist_dir 'Peach'",
            "$item = Get-Item -LiteralPath $link -Force -ErrorAction SilentlyContinue",
            "if ($item -and $item.LinkType -ne 'Junction') {",
            "    Write-Host \"$link is a real folder, not a Scoop link; leaving it untouched.\" -ForegroundColor Yellow",
            "    return",
            "}",
            "if ($item) { [System.IO.Directory]::Delete($link) }",
            "New-Item -ItemType Directory -Path $target -Force | Out-Null",
            "New-Item -ItemType Junction -Path $link -Target $target | Out-Null"
        ]
    },
    "uninstaller": {
        "script": [
            "$link = Join-Path $env:LOCALAPPDATA 'Peach'",
            "$item = Get-Item -LiteralPath $link -Force -ErrorAction SilentlyContinue",
            "if (-not $item -or $item.LinkType -ne 'Junction') { return }",
            "$target = Join-Path $persist_dir 'Peach'",
            "$purgeVar = Get-Variable -Name purge -ErrorAction SilentlyContinue",
            "if (($purgeVar -and $purgeVar.Value) -or -not (Test-Path -LiteralPath $target)) {",
            "    [System.IO.Directory]::Delete($link)",
            "}"
        ]
    },
    "checkver": {
        "url": "https://gitgud.io/api/v4/projects/peach-mitao%2Fpeach/releases",
        "jp": "$[0].tag_name",
        "regex": "v([\\d.]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://downloads.peach.video/v$version/Peach-$version-windows-x64.zip"
            }
        }
    }
}
